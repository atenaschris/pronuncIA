# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=your-project-url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Backend API base URL (Nest, prefix 'api' is set server-side)
EXPO_PUBLIC_PRONUN_API_BASE_URL=http://localhost:3001

# Testing: enable mock pronunciation accuracy (Debug screen can also toggle at runtime)
EXPO_PUBLIC_MOCK_PRONUNCIATION=false